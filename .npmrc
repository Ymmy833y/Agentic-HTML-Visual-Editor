# Do not fetch Playwright's browsers from npm install's postinstall step.
#
# @playwright/browser-chromium arrives as a dependency of @vscode/test-web, and its postinstall goes out
# for Chromium. Where the source (cdn.playwright.dev) is unreachable that download fails, which takes the
# whole npm install down with it and rolls node_modules back. Installing dependencies then hinges on
# whether a browser can be fetched.
#
# Browsers are installed explicitly with `npx playwright install chromium` anyway (AGENTS.md §6), so the
# postinstall fetch was never needed. Stopping it leaves the documented procedure unchanged.
#
# playwright-core also reads environment variables carrying the npm_config_ prefix, so this spelling has
# the same effect as PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD.
playwright_skip_browser_download=1
