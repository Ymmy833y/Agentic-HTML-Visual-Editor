{
  "name": "agentic-html-visual-editor",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.0",
  "keywords": [
    "wysiwyg",
    "html",
    "rich-text",
    "editor",
    "ai",
    "agentic"
  ],
  "publisher": "YuyaMiyamoto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ymmy833y/Agentic-HTML-Visual-Editor.git"
  },
  "homepage": "https://github.com/Ymmy833y/Agentic-HTML-Visual-Editor#readme",
  "bugs": {
    "url": "https://github.com/Ymmy833y/Agentic-HTML-Visual-Editor/issues"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "icon": "assets/icon.png",
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ahve.save",
        "title": "%command.save.title%"
      },
      {
        "command": "ahve.undo",
        "title": "%command.undo.title%"
      },
      {
        "command": "ahve.redo",
        "title": "%command.redo.title%"
      },
      {
        "command": "ahve.recover",
        "title": "%command.recover.title%"
      },
      {
        "command": "ahve.openInWysiwygEditor",
        "title": "%command.openInWysiwygEditor.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "ahve.openInHtmlEditor",
        "title": "%command.openInHtmlEditor.title%",
        "category": "%command.category%",
        "icon": "$(code)"
      },
      {
        "command": "ahve.copyAsHtml",
        "title": "%command.copyAsHtml.title%",
        "category": "%command.category%"
      }
    ],
    "customEditors": [
      {
        "viewType": "ahve.editor",
        "displayName": "%editor.html.displayName%",
        "selector": [
          {
            "filenamePattern": "*.html"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "ahve.documentEditor",
        "displayName": "%editor.html.displayName%",
        "selector": [{ "filenamePattern": "*.ahve-editor" }],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ahve.openInWysiwygEditor",
          "group": "navigation",
          "when": "activeEditor == workbench.editors.files.textFileEditor && resourceFilename =~ /\\.html$/i"
        },
        {
          "command": "ahve.openInHtmlEditor",
          "group": "navigation",
          "when": "activeCustomEditorId =~ /^ahve\\.(documentEditor|editor)$/ && resourceFilename =~ /\\.html$/i"
        }
      ],
      "commandPalette": [
        {
          "command": "ahve.save",
          "when": "false"
        },
        {
          "command": "ahve.undo",
          "when": "false"
        },
        {
          "command": "ahve.redo",
          "when": "false"
        },
        {
          "command": "ahve.recover",
          "when": "activeCustomEditorId == ahve.documentEditor"
        },
        {
          "command": "ahve.openInWysiwygEditor",
          "when": "activeEditor == workbench.editors.files.textFileEditor && resourceFilename =~ /\\.html$/i"
        },
        {
          "command": "ahve.openInHtmlEditor",
          "when": "activeCustomEditorId =~ /^ahve\\.(documentEditor|editor)$/ && resourceFilename =~ /\\.html$/i"
        },
        {
          "command": "ahve.copyAsHtml",
          "when": "activeCustomEditorId =~ /^ahve\\.(documentEditor|editor)$/ && resourceFilename =~ /\\.html$/i"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ahve.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == ahve.documentEditor"
      },
      {
        "command": "ahve.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == ahve.documentEditor"
      },
      {
        "command": "ahve.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == ahve.documentEditor"
      },
      {
        "command": "ahve.redo",
        "key": "ctrl+y",
        "when": "activeCustomEditorId == ahve.documentEditor && !isMac"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc -p common && tsc -p src && tsc -p webview && tsc -p tests && tsc -p tests/integration && tsc -p tests/web",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:prepare": "npm run build && tsc -p tests/integration",
    "test:unit": "vitest run --coverage",
    "pretest:integration": "npm run build && tsc -p tests/integration",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:only": "node scripts/run-integration-tests.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:only": "playwright test",
    "pretest:web": "npm run build && tsc -p tests/web",
    "test:web": "vscode-test-web --browserType=chromium --headless --extensionDevelopmentPath=. --extensionTestsPath=out-test-web/activation.js",
    "notices": "node scripts/release/third-party-notices.mjs",
    "notices:check": "node scripts/release/third-party-notices.mjs --check",
    "readme:images": "npm run build && node scripts/release/readme-images.mjs"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "1.86.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "jsdom": "^26.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "mermaid": "11.17.2",
    "node-diff3": "3.2.1"
  }
}
