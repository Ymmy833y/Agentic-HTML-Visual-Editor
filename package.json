{
  "name": "agentic-html-visual-editor",
  "displayName": "Agentic HTML Visual Editor",
  "description": "A WYSIWYG HTML editor for reviewing and refining AI-generated content in VS Code",
  "version": "0.1.13",
  "keywords": [
    "wysiwyg",
    "html",
    "rich-text",
    "editor",
    "ai",
    "agentic"
  ],
  "publisher": "YuyaMiyamoto",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ymmy833y/Agentic-HTML-Visual-Editor.git"
  },
  "homepage": "https://github.com/Ymmy833y/Agentic-HTML-Visual-Editor#readme",
  "bugs": {
    "url": "https://github.com/Ymmy833y/Agentic-HTML-Visual-Editor/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "assets/icon.png",
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:html"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ahve.openInWysiwygEditor",
        "title": "Open in WYSIWYG",
        "category": "Agentic HTML Visual Editor",
        "icon": "$(edit)"
      },
      {
        "command": "ahve.openInHtmlEditor",
        "title": "Open in HTML",
        "category": "Agentic HTML Visual Editor",
        "icon": "$(code)"
      },
      {
        "command": "ahve.copyAsHtml",
        "title": "Copy as HTML",
        "category": "Agentic HTML Visual Editor"
      }
    ],
    "customEditors": [
      {
        "viewType": "ahve.editor",
        "displayName": "Agentic HTML Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.html"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ahve.openInWysiwygEditor",
          "when": "resourceExtname == .html && activeCustomEditorId != ahve.editor",
          "group": "navigation"
        },
        {
          "command": "ahve.openInHtmlEditor",
          "when": "activeCustomEditorId == ahve.editor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ahve.openInWysiwygEditor",
          "when": "resourceExtname == .html"
        },
        {
          "command": "ahve.openInHtmlEditor",
          "when": "activeCustomEditorId == ahve.editor"
        },
        {
          "command": "ahve.copyAsHtml",
          "when": "activeCustomEditorId == ahve.editor"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ahve.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == ahve.editor"
      },
      {
        "command": "ahve.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == ahve.editor"
      },
      {
        "command": "ahve.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == ahve.editor"
      },
      {
        "command": "ahve.redo",
        "key": "ctrl+shift+z",
        "when": "activeCustomEditorId == ahve.editor"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "vscode:prepublish": "node esbuild.config.js --production",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run build && tsc -p tsconfig.test.json",
    "test:integration": "vscode-test",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.0",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "brace-expansion@>=3.0.0 <6.0.0": "5.0.12",
    "serialize-javascript": "7.0.5",
    "diff": "8.0.3",
    "undici": "7.29.1",
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "node-diff3": "^3.2.1"
  }
}
